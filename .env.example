# ── Конфигурация фронтенда (подставляется на сборке) ───────────────────
# Скопируйте этот файл в .env и заполните под своё окружение.
# ВАЖНО: это статический сайт — значения «запекаются» в HTML во время
# `npm run build`. После изменения .env нужно пересобрать сайт.

# URL эндпоинта email-backend сервиса (POST /api/contact)
CONTACT_API_URL=http://localhost:3000/api/contact

# X-API-Key — заполняется, ТОЛЬКО если на бэкенде задан API_KEY.
# Оставьте пустым, если защита по ключу выключена.
CONTACT_API_KEY=
